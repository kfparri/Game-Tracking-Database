<UserControl x:Class="GameTracker.App.Controls.LabeledField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameTracker.App.Controls"
             mc:Ignorable="d">
    <!--d:DesignHeight="450" d:DesignWidth="800">-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Grid.Column="1" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource FieldValueStyle}"/>
    </Grid>
</UserControl>
